{
  "private": true,
  "devDependencies": {
    "@discourse/lint-configs": "2.43.0",
    "ember-template-lint": "7.9.3",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "stylelint": "17.4.0"
  },
  "scripts": {
    "lint": "pnpm lint:js && pnpm lint:hbs && pnpm lint:css && pnpm lint:prettier",
    "lint:js": "eslint assets/javascripts --no-error-on-unmatched-pattern",
    "lint:js:fix": "eslint assets/javascripts --fix --no-error-on-unmatched-pattern",
    "lint:hbs": "ember-template-lint 'assets/javascripts/**/*.gjs' --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint 'assets/javascripts/**/*.gjs' --fix --no-error-on-unmatched-pattern",
    "lint:css": "stylelint 'assets/stylesheets/**/*.scss' --allow-empty-input",
    "lint:css:fix": "stylelint 'assets/stylesheets/**/*.scss' --fix --allow-empty-input",
    "lint:prettier": "prettier 'assets/stylesheets/**/*.scss' 'assets/javascripts/**/*.{js,gjs}' --check --no-error-on-unmatched-pattern",
    "lint:prettier:fix": "prettier 'assets/stylesheets/**/*.scss' 'assets/javascripts/**/*.{js,gjs}' -w --no-error-on-unmatched-pattern"
  }
}
